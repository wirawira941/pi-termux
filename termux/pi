#!/data/data/com.termux/files/usr/bin/bash
# Pi coding agent launcher for Termux
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
LIBEXEC="$PREFIX/libexec/pi-termux"
# Fix for Bun on Android: process.execPath points to linker64, not the binary
export PI_PACKAGE_DIR="$LIBEXEC"
exec "$LIBEXEC/pi.bin" "$@"
